# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server configuration
PORT=3000
NODE_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------
# Database Configuration — Aiven MySQL (production source of truth)
# Pick ONE format. DATABASE_URL takes precedence when set.
# Example: DATABASE_URL="mysql://avnadmin:PASSWORD@HOST:PORT/defaultdb?ssl-mode=REQUIRED"
# ------------------------------------------------------------------
DATABASE_URL=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=defaultdb
# Optional aliases accepted by the backend (DB_* mirror MYSQL_*)
# DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD are also read.
# Optional PEM content for Aiven CA (enables full chain verification).
# If empty, TLS stays ENABLED with encrypted-but-unverified mode.
MYSQL_SSL_CA=
DB_SSL=true

# ------------------------------------------------------------------
# Valkey / Redis Configuration — Aiven Valkey (session + denylist)
# Pick ONE format. VALKEY_URL / REDIS_URL takes precedence when set.
# Example: VALKEY_URL="rediss://default:PASSWORD@HOST:PORT"
# ------------------------------------------------------------------
VALKEY_URL=
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Set "rediss://" scheme or VALKEY_TLS=true to force TLS.
VALKEY_TLS=

# Security — REQUIRED in production (server refuses to boot otherwise)
JWT_SECRET=change_me_generate_32plus_random_chars
SESSION_SECRET=change_me_generate_32plus_random_chars

# Demo seeding — NEVER enable in production. Keeps demo accounts out
# of the production auth flow unless explicitly opted in for local dev.
SEED_DEMO_USERS=false

# ------------------------------------------------------------------
# QA / test accounts (opt-in). Seeded at server start into the ACTIVE
# auth store (Aiven MySQL when configured, local dev store otherwise).
# They are REAL rows equivalent to a freshly registered user:
# profile created, coins 0, no spirits, no progress.
# Passwords are stored as bcrypt hashes only.
# Refused when NODE_ENV=production unless ALLOW_TEST_SEED_IN_PRODUCTION=true.
#
# Example:
#   SEED_TEST_USERS="khang,thư"
#   SEED_TEST_PASSWORD="882003"
#
# "username|email" entries override the derived email address.
# ------------------------------------------------------------------
SEED_TEST_USERS=
SEED_TEST_PASSWORD=
SEED_TEST_EMAIL_DOMAIN=linhthuhoi.com
ALLOW_TEST_SEED_IN_PRODUCTION=false

# ------------------------------------------------------------------
# LOCAL DEV ONLY (never production): point the dev catalog/user store at
# a file instead of the default in-memory DB so locally created accounts
# and progress survive a restart. Auth in production always uses MySQL.
# Leave empty/comment out to keep the in-memory default.
# ------------------------------------------------------------------
# DEV_SQLITE_PATH=./.dev-data/local-dev.sqlite

